/** Trusted Circle cashback wallet. Cashback is credited only after verified payment. */
var TC_WALLET={WALLET:'CashbackWallet',TX:'CashbackTransactions',REDEEM:'WalletRedemptions',MAX_ORDER:2000,METHODS:['UPI','BANK']};
function ensureWalletSheets_(){ensureSheet_(TC_WALLET.WALLET,['WalletID','UserID','Balance','TotalEarned','TotalRedeemed','UpdatedAt']);ensureSheet_(TC_WALLET.TX,['TransactionID','WalletID','UserID','Type','OrderID','Amount','BalanceAfter','Status','Description','CreatedAt']);ensureSheet_(TC_WALLET.REDEEM,['RedemptionID','WalletID','UserID','Amount','Method','UPIId','BankAccount','IFSC','Status','CreatedAt','UpdatedAt','AdminNote']);}
function getWallet_(userId){ensureWalletSheets_();var row=getRows_(TC_WALLET.WALLET).find(function(r){return String(r.UserID)===String(userId);});if(row)return row;var now=isoNow_(),wallet={WalletID:newId_('TCWAL'),UserID:userId,Balance:0,TotalEarned:0,TotalRedeemed:0,UpdatedAt:now};appendRowObject_(TC_WALLET.WALLET,wallet);return findOne_(TC_WALLET.WALLET,'WalletID',wallet.WalletID);}
function walletPublic_(userId){var wallet=getWallet_(userId);return{walletId:wallet.WalletID,balance:Number(wallet.Balance||0),totalEarned:Number(wallet.TotalEarned||0),totalRedeemed:Number(wallet.TotalRedeemed||0)};}
function walletData_(data){var user=authenticate_(data.token),wallet=walletPublic_(user.UserID),transactions=getRows_(TC_WALLET.TX).filter(function(r){return String(r.UserID)===String(user.UserID);});transactions.sort(function(a,b){return new Date(b.CreatedAt).getTime()-new Date(a.CreatedAt).getTime();});return{wallet:wallet,transactions:transactions.slice(0,100).map(function(r){return{type:String(r.Type||''),orderId:String(r.OrderID||''),amount:Number(r.Amount||0),balanceAfter:Number(r.BalanceAfter||0),status:String(r.Status||''),description:String(r.Description||''),createdAt:r.CreatedAt};})};}
function creditCashbackForOrder_(order){ensureWalletSheets_();var amount=Math.round(Number(order.Discount||0)*100)/100;if(!(amount>0))return false;var txs=getRows_(TC_WALLET.TX).filter(function(r){return String(r.OrderID)===String(order.OrderID)&&String(r.Type).toUpperCase()==='CASHBACK_EARNED'&&String(r.Status).toUpperCase()==='COMPLETED';});if(txs.length)return false;var lock=LockService.getScriptLock();lock.waitLock(10000);try{txs=getRows_(TC_WALLET.TX).filter(function(r){return String(r.OrderID)===String(order.OrderID)&&String(r.Type).toUpperCase()==='CASHBACK_EARNED'&&String(r.Status).toUpperCase()==='COMPLETED';});if(txs.length)return false;var wallet=getWallet_(order.UserID),balance=Math.round((Number(wallet.Balance||0)+amount)*100)/100,now=isoNow_();updateRowById_(TC_WALLET.WALLET,'WalletID',wallet.WalletID,{Balance:balance,TotalEarned:Math.round((Number(wallet.TotalEarned||0)+amount)*100)/100,UpdatedAt:now});appendRowObject_(TC_WALLET.TX,{TransactionID:newId_('TCWTX'),WalletID:wallet.WalletID,UserID:order.UserID,Type:'CASHBACK_EARNED',OrderID:order.OrderID,Amount:amount,BalanceAfter:balance,Status:'COMPLETED',Description:'Cashback for order '+order.OrderNumber,CreatedAt:now});return true;}finally{lock.releaseLock();}}
function requestWalletRedemption_(data){var user=authenticate_(data.token),amount=Math.round(Number(data.amount||0)*100)/100,method=String(data.method||'').toUpperCase(),upi=cleanText_(data.upiId||'',200),account=cleanText_(data.bankAccount||'',80),ifsc=cleanText_(data.ifsc||'',20);require_(isFinite(amount)&&amount>0,'Enter a valid amount.');require_(['UPI','BANK'].indexOf(method)>=0,'Choose a redemption method.');if(method==='UPI')require_(/^[\w.\-]{2,}@[\w.\-]{2,}$/.test(upi),'Enter a valid UPI ID.');if(method==='BANK')require_(account&&/^[A-Za-z]{4}0[A-Za-z0-9]{6}$/i.test(ifsc),'Enter valid bank details.');var lock=LockService.getScriptLock();lock.waitLock(10000);try{var wallet=getWallet_(user.UserID);require_(amount<=Number(wallet.Balance||0),'Insufficient cashback balance.');var open=getRows_(TC_WALLET.REDEEM).filter(function(r){return String(r.UserID)===String(user.UserID)&&['REQUESTED','PROCESSING'].indexOf(String(r.Status).toUpperCase())>=0;});require_(open.length===0,'A redemption request is already pending.');var now=isoNow(),id=newId_('TCWRD'),newBalance=Math.round((Number(wallet.Balance)-amount)*100)/100;updateRowById_(TC_WALLET.WALLET,'WalletID',wallet.WalletID,{Balance:newBalance,TotalRedeemed:Math.round((Number(wallet.TotalRedeemed||0)+amount)*100)/100,UpdatedAt:now});appendRowObject_(TC_WALLET.REDEEM,{RedemptionID:id,WalletID:wallet.WalletID,UserID:user.UserID,Amount:amount,Method:method,UPIId:method==='UPI'?upi:'',BankAccount:method==='BANK'?account:'',IFSC:method==='BANK'?ifsc:'',Status:'REQUESTED',CreatedAt:now,UpdatedAt:now,AdminNote:''});appendRowObject_(TC_WALLET.TX,{TransactionID:newId_('TCWTX'),WalletID:wallet.WalletID,UserID:user.UserID,Type:'REDEMPTION_REQUEST',OrderID:'',Amount:-amount,BalanceAfter:newBalance,Status:'COMPLETED',Description:'Cashback redemption requested',CreatedAt:now});return{redemption:findOne_(TC_WALLET.REDEEM,'RedemptionID',id),wallet:walletPublic_(user.UserID)};}finally{lock.releaseLock();}}
