/** Generic signed payment webhook. Map the gateway webhook to this endpoint with the Script Property PAYMENT_WEBHOOK_SECRET. */
function paymentWebhook_(data){var secret=getScriptProperties_().getProperty('PAYMENT_WEBHOOK_SECRET')||'';require_(secret,'Payment webhook is not configured.');var supplied=String(data.webhookSecret||data.secret||'');require_(constantTimeEquals_(supplied,secret),'Invalid payment webhook.');var orderNumber=cleanText_(data.orderNumber||'',100),orderId=cleanText_(data.orderId||'',100),status=String(data.status||'').toUpperCase(),amount=Number(data.amount||0),paymentId=cleanText_(data.paymentId||data.providerPaymentId||'',200),provider=cleanText_(data.provider||'GATEWAY',80);require_(orderNumber||orderId,'Order reference is required.');expirePaymentLinkReservations_();var order=orderId?findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId):findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderNumber',orderNumber);require_(order,'Order not found.');require_(Math.abs(Number(order.Total||0)-amount)<0.01,'Payment amount does not match the order.');require_(['SUCCESS','PAID','CAPTURED','COMPLETED'].indexOf(status)>=0,'Payment is not successful.');var paymentLinks=[];try{paymentLinks=getRows_(TC_CONFIG.SHEETS.PAYMENT_LINKS).filter(function(r){return String(r.OrderID)===String(order.OrderID)&&String(r.Status||'').toUpperCase()==='ACTIVE';});}catch(ignore){}if(paymentLinks.length){var stock=paymentLinks[paymentLinks.length-1].PaymentLinkStockID?findOne_(TC_CONFIG.SHEETS.PAYMENT_LINK_STOCK,'PaymentLinkStockID',paymentLinks[paymentLinks.length-1].PaymentLinkStockID):null;require_(stock&&String(stock.Status||'').toUpperCase()==='RESERVED'&&(!stock.ExpiresAt||new Date(stock.ExpiresAt).getTime()>Date.now()),'Payment link has expired. Please request a new payment link.');}var lock=LockService.getScriptLock();lock.waitLock(10000);try{var payments=getRows_(TC_CONFIG.SHEETS.PAYMENTS).filter(function(r){return String(r.OrderID)===String(order.OrderID);}),now=isoNow_();if(payments.length){var last=payments[payments.length-1];if(String(last.Status||'').toUpperCase()!=='VERIFIED')updateRowById_(TC_CONFIG.SHEETS.PAYMENTS,'PaymentID',last.PaymentID,{Provider:provider,ProviderPaymentID:paymentId,Amount:amount,Status:'VERIFIED',VerifiedAt:now,UpdatedAt:now});}else appendRowObject_(TC_CONFIG.SHEETS.PAYMENTS,{PaymentID:newId_('TCPAY'),OrderID:order.OrderID,Provider:provider,ProviderOrderID:order.OrderNumber,ProviderPaymentID:paymentId,Amount:amount,Currency:'INR',Status:'VERIFIED',VerifiedAt:now,CreatedAt:now,UpdatedAt:now});updateRowById_(TC_CONFIG.SHEETS.ORDERS,'OrderID',order.OrderID,{Status:'PAID',UpdatedAt:now});creditCashbackForOrder_(findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',order.OrderID));if(typeof markPaymentLinkStockUsedForOrder_==='function')markPaymentLinkStockUsedForOrder_(order.OrderID,now);return{ok:true,orderNumber:order.OrderNumber,status:'PAID'};}finally{lock.releaseLock();}}
