/** Trusted Circle ERP — admin-only service layer. Secrets stay in Script Properties. */
var TC_ADMIN_SHEETS={Users:'UserID',OTP:'OtpID',UserSessions:'SessionID',AuditLogs:'AuditID',Products:'ProductID',Brands:'BrandID',Cart:'CartID',Orders:'OrderID',OrderItems:'OrderItemID',Payments:'PaymentID',PaymentLinks:'PaymentLinkID',Vouchers:'VoucherID',Notifications:'NotificationID'};
var TC_ADMIN_EDITABLE={Users:['Email','Name','Role','Status'],Products:['BrandID','SKU','Title','Description','FaceValue','SellingPrice','DiscountPercent','Currency','InventoryStatus','Active'],Brands:['Name','Slug','LogoURL','Active'],Cart:['Quantity','Denomination'],Orders:['Status','Subtotal','Discount','Total','Currency'],OrderItems:['Quantity','FaceValue','UnitPrice','Denomination','Total'],Payments:['Provider','ProviderOrderID','ProviderPaymentID','Amount','Currency','Status','VerifiedAt'],PaymentLinks:['Link','Label','Status'],Vouchers:['ProductID','Code','Pin','Status','IssuedAt','DeliveredAt'],Notifications:['Type','Title','Message','ReadAt']};
function ensurePaymentLinksSheet_(){return ensureSheet_(TC_CONFIG.SHEETS.PAYMENT_LINKS,['PaymentLinkID','OrderID','Link','Label','Status','CreatedAt','UpdatedAt']);}
function adminLogin_(data){var email=normalizeEmail_(data.email),password=String(data.password||'');require_(email===getAdminEmail_(),'Invalid ERP credentials.');var configured=getAdminPassword_();require_(configured,'ERP admin password is not configured in Script Properties.');require_(constantTimeEquals_(password,configured),'Invalid ERP credentials.');var user=getUserByEmail_(email)||createOrGetUser_(email,'Admin');require_(String(user.Role).toUpperCase()==='ADMIN','ERP access denied.');updateRowById_(TC_CONFIG.SHEETS.USERS,'UserID',user.UserID,{Role:'ADMIN',Status:'ACTIVE',LastLoginAt:isoNow_(),UpdatedAt:isoNow_()});var refreshed=getUserByEmail_(email),session=issueSession_(refreshed);appendAudit_(refreshed.UserID,'ERP_LOGIN','Admin','',{});return{user:publicUser_(refreshed),session:session};}
function adminAuthenticate_(token){var user=authenticate_(token);require_(String(user.Role||'').toUpperCase()==='ADMIN','ERP administrator access required.');require_(normalizeEmail_(user.Email)===getAdminEmail_(),'ERP administrator access required.');return user;}
function appendAudit_(userId,action,entity,entityId,metadata){appendRowObject_(TC_CONFIG.SHEETS.AUDIT,{AuditID:newId_('TCAUD'),UserID:userId,Action:action,Entity:entity,EntityID:entityId||'',Metadata:JSON.stringify(metadata||{}),CreatedAt:isoNow_()});}
function adminDashboard_(data){var admin=adminAuthenticate_(data.token);ensurePaymentLinksSheet_();var sheetNames=Object.keys(TC_ADMIN_SHEETS),tables={};sheetNames.forEach(function(name){var rows=getRows_(TC_CONFIG.SHEETS[name]||name);tables[name]={idField:TC_ADMIN_SHEETS[name],columns:rows.length?Object.keys(rows[0]):getSheetHeaders_(name),rows:rows.slice(-500).reverse()};});var orders=tables.Orders?tables.Orders.rows:[];return{admin:publicUser_(admin),tables:tables,metrics:{shoppers:(tables.Users?.rows||[]).filter(function(r){return String(r.Role||'').toUpperCase()!=='ADMIN';}).length,orders:orders.length,pendingOrders:orders.filter(function(r){return String(r.Status||'').toUpperCase()==='PENDING_PAYMENT';}).length,paidOrders:orders.filter(function(r){return String(r.Status||'').toUpperCase()==='PAID';}).length,revenue:orders.filter(function(r){return String(r.Status||'').toUpperCase()==='PAID';}).reduce(function(s,r){return s+Number(r.Total||0);},0)}};}
function getSheetHeaders_(name){var sheet=getSpreadsheet_().getSheetByName(name);return sheet?sheet.getRange(1,1,1,Math.max(1,sheet.getLastColumn())).getValues()[0]:[];}
function adminUpdateRow_(data){var admin=adminAuthenticate_(data.token),sheetName=cleanText_(data.sheet,60),idField=TC_ADMIN_SHEETS[sheetName],id=cleanText_(data.id,200),patch=data.patch||{};require_(idField,'Unknown ERP sheet.');require_(id,'Row ID is required.');var allowed=TC_ADMIN_EDITABLE[sheetName]||[];var clean={};Object.keys(patch).forEach(function(key){if(allowed.indexOf(key)>=0)clean[key]=cleanText_(patch[key],10000);});require_(Object.keys(clean).length>0,'No editable fields supplied.');require_(updateRowById_(sheetName,idField,id,clean),'Record not found.');appendAudit_(admin.UserID,'UPDATE',sheetName,id,clean);return{ok:true,row:findOne_(sheetName,idField,id)};}
function adminCreatePaymentLink_(data){var admin=adminAuthenticate_(data.token);ensurePaymentLinksSheet_();var orderId=cleanText_(data.orderId,100),link=cleanText_(data.link,2000),label=cleanText_(data.label||'Pay Now',100);require_(orderId&&link,'Order and payment link are required.');require_(/^https:\/\//i.test(link),'Payment link must use HTTPS.');var order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order,'Order not found.');var now=isoNow(),id=newId_('TCPL');appendRowObject_(TC_CONFIG.SHEETS.PAYMENT_LINKS,{PaymentLinkID:id,OrderID:orderId,Link:link,Label:label,Status:'ACTIVE',CreatedAt:now,UpdatedAt:now});appendRowObject_(TC_CONFIG.SHEETS.PAYMENTS,{PaymentID:newId_('TCPAY'),OrderID:orderId,Provider:'PAYMENT_LINK',ProviderOrderID:'',ProviderPaymentID:'',Amount:Number(order.Total||0),Currency:'INR',Status:'PENDING',VerifiedAt:'',CreatedAt:now,UpdatedAt:now});appendAudit_(admin.UserID,'PAYMENT_LINK_CREATED','Order',orderId,{link:link});return{paymentLink:findOne_(TC_CONFIG.SHEETS.PAYMENT_LINKS,'PaymentLinkID',id)};}
function adminConfirmPayment_(data){var admin=adminAuthenticate_(data.token),orderId=cleanText_(data.orderId,100),provider=cleanText_(data.provider||'MANUAL',80),providerPaymentId=cleanText_(data.providerPaymentId||'',200);var order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order,'Order not found.');var now=isoNow(),payments=getRows_(TC_CONFIG.SHEETS.PAYMENTS).filter(function(r){return String(r.OrderID)===orderId;});if(payments.length)updateRowById_(TC_CONFIG.SHEETS.PAYMENTS,'PaymentID',payments[payments.length-1].PaymentID,{Provider:provider,ProviderPaymentID:providerPaymentId,Status:'VERIFIED',VerifiedAt:now,UpdatedAt:now});else appendRowObject_(TC_CONFIG.SHEETS.PAYMENTS,{PaymentID:newId_('TCPAY'),OrderID:orderId,Provider:provider,ProviderOrderID:'',ProviderPaymentID:providerPaymentId,Amount:Number(order.Total||0),Currency:'INR',Status:'VERIFIED',VerifiedAt:now,CreatedAt:now,UpdatedAt:now});updateRowById_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId,{Status:'PAID',UpdatedAt:now});appendRowObject_(TC_CONFIG.SHEETS.NOTIFICATIONS,{NotificationID:newId_('TCNOT'),UserID:order.UserID,Type:'PAYMENT',Title:'Payment confirmed',Message:'Payment for order '+order.OrderNumber+' has been confirmed.',ReadAt:'',CreatedAt:now});appendAudit_(admin.UserID,'PAYMENT_CONFIRMED','Order',orderId,{provider:provider});return{order:findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId)};}
function adminSendVoucher_(data){var admin=adminAuthenticate_(data.token),orderId=cleanText_(data.orderId,100),code=cleanText_(data.code,500),pin=cleanText_(data.pin||'',200),productId=cleanText_(data.productId||'',100),sendEmail=String(data.sendEmail||'true').toLowerCase()!=='false';require_(orderId&&code,'Order and voucher code are required.');var order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order,'Order not found.');var user=findOne_(TC_CONFIG.SHEETS.USERS,'UserID',order.UserID);require_(user,'Shopper not found.');var now=isoNow(),id=newId_('TCVOU');appendRowObject_(TC_CONFIG.SHEETS.VOUCHERS,{VoucherID:id,ProductID:productId,OrderID:orderId,Code:code,Pin:pin,Status:'DELIVERED',IssuedAt:now,DeliveredAt:now});updateRowById_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId,{Status:'DELIVERED',UpdatedAt:now});var message='Your voucher for order '+order.OrderNumber+' is ready. Code: '+code+(pin?' | PIN: '+pin:'');appendRowObject_(TC_CONFIG.SHEETS.NOTIFICATIONS,{NotificationID:newId_('TCNOT'),UserID:user.UserID,Type:'VOUCHER',Title:'Voucher delivered',Message:message,ReadAt:'',CreatedAt:now});if(sendEmail&&isValidEmail_(user.Email)){MailApp.sendEmail({to:user.Email,subject:'Trusted Circle — Voucher '+order.OrderNumber,htmlBody:'<p>Your Trusted Circle voucher is ready.</p><p><b>Order:</b> '+order.OrderNumber+'<br><b>Code:</b> '+escapeHtml_(code)+(pin?'<br><b>PIN:</b> '+escapeHtml_(pin):'')+'</p><p>Thank you for shopping with Trusted Circle.</p>',body:'Your Trusted Circle voucher is ready. Order: '+order.OrderNumber+'. Code: '+code+(pin?' | PIN: '+pin:'')});}appendAudit_(admin.UserID,'VOUCHER_SENT','Order',orderId,{voucherId:id,email:user.Email});return{voucher:findOne_(TC_CONFIG.SHEETS.VOUCHERS,'VoucherID',id),order:findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId)};}
function adminConfirmOrder_(data){var admin=adminAuthenticate_(data.token),orderId=cleanText_(data.orderId,100),status=cleanText_(data.status,50).toUpperCase(),allowed=['PENDING_PAYMENT','PAYMENT_PROCESSING','PAID','PROCESSING','DELIVERED','CANCELLED','REFUNDED','FAILED'];require_(allowed.indexOf(status)>=0,'Invalid order status.');var order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order,'Order not found.');updateRowById_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId,{Status:status,UpdatedAt:isoNow_()});appendAudit_(admin.UserID,'ORDER_STATUS','Order',orderId,{status:status});return{order:findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId)};}
