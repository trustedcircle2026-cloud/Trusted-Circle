/** Trusted Circle ERP — admin-only service layer. Secrets stay in Script Properties. */
var TC_ADMIN_SHEETS={Users:'UserID',OTP:'OtpID',UserSessions:'SessionID',AuditLogs:'AuditID',Products:'ProductID',Brands:'BrandID',Cart:'CartID',Orders:'OrderID',OrderItems:'OrderItemID',Payments:'PaymentID',PaymentLinks:'PaymentLinkID',PaymentLinkRequests:'RequestID',PaymentLinkStock:'PaymentLinkStockID',Vouchers:'VoucherID',Notifications:'NotificationID',CashbackWallet:'WalletID',CashbackTransactions:'TransactionID',WalletRedemptions:'RedemptionID'};
var TC_ADMIN_EDITABLE={Users:['Email','Name','Role','Status'],Products:['BrandID','SKU','Title','Description','FaceValue','SellingPrice','DiscountPercent','Currency','InventoryStatus','Active'],Brands:['Name','Slug','LogoURL','Active'],Cart:['Quantity'],Orders:['Status'],OrderItems:['Quantity'],Payments:['Provider','ProviderOrderID','ProviderPaymentID','Amount','Currency','Status','VerifiedAt'],PaymentLinks:['Link','Label','Status'],PaymentLinkRequests:['Status','AdminNote'],PaymentLinkStock:['Denomination','Link','Label','Status','OrderID','PaymentLinkID','UpdatedAt'],Vouchers:['ProductID','Code','Pin','Status','IssuedAt','DeliveredAt'],Notifications:['Type','Title','Message','ReadAt'],WalletRedemptions:['Status','AdminNote']};
function ensurePaymentLinksSheet_(){return ensureSheet_(TC_CONFIG.SHEETS.PAYMENT_LINKS,['PaymentLinkID','OrderID','Link','Label','Status','PaymentLinkStockID','CreatedAt','UpdatedAt']);}
function ensurePaymentLinkRequestsSheet_(){return ensureSheet_(TC_CONFIG.SHEETS.PAYMENT_LINK_REQUESTS,['RequestID','OrderID','UserID','Email','Status','AdminNote','PaymentLinkID','CreatedAt','UpdatedAt']);}
function adminLogin_(data){var email=normalizeEmail_(data.email),password=String(data.password||'');require_(email===getAdminEmail_(),'Invalid ERP credentials.');var configured=getAdminPassword_();require_(configured,'ERP admin password is not configured in Script Properties.');require_(constantTimeEquals_(password,configured),'Invalid ERP credentials.');var user=getUserByEmail_(email)||createOrGetUser_(email,'Admin');require_(String(user.Role).toUpperCase()==='ADMIN','ERP access denied.');updateRowById_(TC_CONFIG.SHEETS.USERS,'UserID',user.UserID,{Role:'ADMIN',Status:'ACTIVE',LastLoginAt:isoNow_(),UpdatedAt:isoNow_()});var refreshed=getUserByEmail_(email),session=issueSession_(refreshed);appendAudit_(refreshed.UserID,'ERP_LOGIN','Admin','',{});return{user:publicUser_(refreshed),session:session};}
function adminAuthenticate_(token){var user=authenticate_(token);require_(String(user.Role||'').toUpperCase()==='ADMIN','ERP administrator access required.');require_(normalizeEmail_(user.Email)===getAdminEmail_(),'ERP administrator access required.');return user;}
function appendAudit_(userId,action,entity,entityId,metadata){appendRowObject_(TC_CONFIG.SHEETS.AUDIT,{AuditID:newId_('TCAUD'),UserID:userId,Action:action,Entity:entity,EntityID:entityId||'',Metadata:JSON.stringify(metadata||{}),CreatedAt:isoNow_()});}
function getSheetHeaders_(name){var sheet=getSpreadsheet_().getSheetByName(name);return sheet?sheet.getRange(1,1,1,Math.max(1,sheet.getLastColumn())).getValues()[0]:[];}
function adminDashboard_(data){var admin=adminAuthenticate_(data.token);ensurePaymentLinksSheet_();ensurePaymentLinkRequestsSheet_();ensurePaymentLinkStockSheet_();ensureWalletSheets_();var sheetNames=Object.keys(TC_ADMIN_SHEETS),tables={};sheetNames.forEach(function(name){var rows=getRows_(TC_CONFIG.SHEETS[name]||name);tables[name]={idField:TC_ADMIN_SHEETS[name],columns:rows.length?Object.keys(rows[0]):getSheetHeaders_(name),rows:rows.slice(-500).reverse()};});var orders=tables.Orders?tables.Orders.rows:[],pending=orders.filter(function(r){return String(r.Status).toUpperCase()==='PENDING_PAYMENT';});return{admin:publicUser_(admin),tables:tables,worklist:pending.slice(0,20).map(function(o){return{type:'PAYMENT',title:'Payment pending',description:'Order '+o.OrderNumber+' is awaiting payment.',orderId:o.OrderID};}),reports:{revenue:orders.filter(function(r){return String(r.Status).toUpperCase()==='PAID';}).reduce(function(s,r){return s+Number(r.Total||0);},0),orders:orders.length},shopperReport:[],metrics:{shoppers:(tables.Users?.rows||[]).filter(function(r){return String(r.Role||'').toUpperCase()!=='ADMIN';}).length,orders:orders.length,pendingOrders:pending.length,paidOrders:orders.filter(function(r){return String(r.Status||'').toUpperCase()==='PAID';}).length,revenue:orders.filter(function(r){return String(r.Status||'').toUpperCase()==='PAID';}).reduce(function(s,r){return s+Number(r.Total||0);},0)}};}
function adminDashboardFast_(data){return adminDashboard_(data);}
function adminTable_(data){var admin=adminAuthenticate_(data.token),sheet=cleanText_(data.sheet,60),idField=TC_ADMIN_SHEETS[sheet];require_(idField,'Unknown ERP sheet.');var rows=getRows_(TC_CONFIG.SHEETS[sheet]||sheet);return{table:{idField:idField,columns:rows.length?Object.keys(rows[0]):getSheetHeaders_(sheet),rows:rows.slice(-500).reverse()}};}
function adminUpdateRow_(data){var admin=adminAuthenticate_(data.token),sheetName=cleanText_(data.sheet,60),idField=TC_ADMIN_SHEETS[sheetName],id=cleanText_(data.id,200),patch=data.patch||{};require_(idField,'Unknown ERP sheet.');require_(id,'Row ID is required.');var allowed=TC_ADMIN_EDITABLE[sheetName]||[],clean={};Object.keys(patch).forEach(function(key){if(allowed.indexOf(key)>=0)clean[key]=cleanText_(patch[key],10000);});require_(Object.keys(clean).length>0,'No editable fields supplied.');require_(findOne_(sheetName,idField,id),'Record not found.');require_(updateRowById_(sheetName,idField,id,clean),'Record not found.');appendAudit_(admin.UserID,'UPDATE',sheetName,id,clean);return{ok:true,row:findOne_(sheetName,idField,id)};}
function adminCreatePaymentLink_(data){var admin=adminAuthenticate_(data.token);ensurePaymentLinksSheet_();ensurePaymentLinkRequestsSheet_();var orderId=cleanText_(data.orderId,100),link=cleanText_(data.link,2000),label=cleanText_(data.label||'Pay Now',100),requestId=cleanText_(data.requestId||'',100);require_(orderId&&link,'Order and payment link are required.');require_(/^https:\/\//i.test(link),'Payment link must use HTTPS.');var order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order,'Order not found.');var user=findOne_(TC_CONFIG.SHEETS.USERS,'UserID',order.UserID);require_(user,'Shopper not found.');var now=isoNow_(),id=newId_('TCPL');appendRowObject_(TC_CONFIG.SHEETS.PAYMENT_LINKS,{PaymentLinkID:id,OrderID:orderId,Link:link,Label:label,Status:'ACTIVE',PaymentLinkStockID:'',CreatedAt:now,UpdatedAt:now});var payments=getRows_(TC_CONFIG.SHEETS.PAYMENTS).filter(function(r){return String(r.OrderID)===orderId;});if(!payments.length)appendRowObject_(TC_CONFIG.SHEETS.PAYMENTS,{PaymentID:newId_('TCPAY'),OrderID:orderId,Provider:'PAYMENT_LINK',ProviderOrderID:'',ProviderPaymentID:'',Amount:Number(order.Total||0),Currency:'INR',Status:'PENDING',VerifiedAt:'',CreatedAt:now,UpdatedAt:now});if(requestId){var req=findOne_(TC_CONFIG.SHEETS.PAYMENT_LINK_REQUESTS,'RequestID',requestId);if(req)updateRowById_(TC_CONFIG.SHEETS.PAYMENT_LINK_REQUESTS,'RequestID',requestId,{Status:'LINK_SENT',PaymentLinkID:id,UpdatedAt:now,AdminNote:cleanText_(data.adminNote||req.AdminNote||'',1000)});}if(typeof sendPaymentLinkEmails_==='function')sendPaymentLinkEmails_(order,user,link,label);appendAudit_(admin.UserID,'PAYMENT_LINK_CREATED','Order',orderId,{requestId:requestId});return{paymentLink:findOne_(TC_CONFIG.SHEETS.PAYMENT_LINKS,'PaymentLinkID',id),order:order};}
function adminPaymentLinkRequest_(data){var admin=adminAuthenticate_(data.token);ensurePaymentLinkRequestsSheet_();var requestId=cleanText_(data.requestId,100),status=cleanText_(data.status||'',40).toUpperCase(),note=cleanText_(data.adminNote||'',1000),request=findOne_(TC_CONFIG.SHEETS.PAYMENT_LINK_REQUESTS,'RequestID',requestId);require_(request,'Payment link request not found.');var allowed=['REQUESTED','PROCESSING','LINK_SENT','CANCELLED'];if(status)require_(allowed.indexOf(status)>=0,'Invalid payment-link request status.');var patch={UpdatedAt:isoNow_(),AdminNote:note};if(status)patch.Status=status;updateRowById_(TC_CONFIG.SHEETS.PAYMENT_LINK_REQUESTS,'RequestID',requestId,patch);appendAudit_(admin.UserID,'PAYMENT_LINK_REQUEST','PaymentLinkRequest',requestId,{status:status,note:note});return{request:findOne_(TC_CONFIG.SHEETS.PAYMENT_LINK_REQUESTS,'RequestID',requestId)};}
function adminConfirmPayment_(data){var admin=adminAuthenticate_(data.token),orderId=cleanText_(data.orderId,100),provider=cleanText_(data.provider||'MANUAL',80),providerPaymentId=cleanText_(data.providerPaymentId||'',200),order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order,'Order not found.');var now=isoNow_(),payments=getRows_(TC_CONFIG.SHEETS.PAYMENTS).filter(function(r){return String(r.OrderID)===orderId;});if(payments.length)updateRowById_(TC_CONFIG.SHEETS.PAYMENTS,'PaymentID',payments[payments.length-1].PaymentID,{Provider:provider,ProviderPaymentID:providerPaymentId,Status:'VERIFIED',VerifiedAt:now,UpdatedAt:now});else appendRowObject_(TC_CONFIG.SHEETS.PAYMENTS,{PaymentID:newId_('TCPAY'),OrderID:orderId,Provider:provider,ProviderOrderID:'',ProviderPaymentID:providerPaymentId,Amount:Number(order.Total||0),Currency:'INR',Status:'VERIFIED',VerifiedAt:now,CreatedAt:now,UpdatedAt:now});updateRowById_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId,{Status:'PAID',UpdatedAt:now});creditCashbackForOrder_(findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId));appendAudit_(admin.UserID,'PAYMENT_CONFIRMED','Order',orderId,{provider:provider});return{order:findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId)};}
function adminSendVoucher_(data){var admin=adminAuthenticate_(data.token),orderId=cleanText_(data.orderId,100),code=cleanText_(data.code,500),pin=cleanText_(data.pin||'',200),productId=cleanText_(data.productId||'',100),sendEmail=String(data.sendEmail||'true').toLowerCase()!=='false',order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order&&code,'Order and voucher code are required.');require_(String(order.Status||'').toUpperCase()==='PAID','Payment must be verified before sending the voucher.');var user=findOne_(TC_CONFIG.SHEETS.USERS,'UserID',order.UserID);require_(user,'Shopper not found.');var now=isoNow_(),id=newId_('TCVOU');appendRowObject_(TC_CONFIG.SHEETS.VOUCHERS,{VoucherID:id,ProductID:productId,OrderID:orderId,Code:code,Pin:pin,Status:'DELIVERED',IssuedAt:now,DeliveredAt:now});updateRowById_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId,{Status:'DELIVERED',UpdatedAt:now});appendRowObject_(TC_CONFIG.SHEETS.NOTIFICATIONS,{NotificationID:newId_('TCNOT'),UserID:user.UserID,Type:'VOUCHER',Title:'Voucher delivered',Message:'Your voucher is ready.',ReadAt:'',CreatedAt:now});if(sendEmail&&typeof sendVoucherEmails_==='function')sendVoucherEmails_(order,user,code,pin);appendAudit_(admin.UserID,'VOUCHER_SENT','Order',orderId,{voucherId:id});return{voucher:findOne_(TC_CONFIG.SHEETS.VOUCHERS,'VoucherID',id),order:findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId)};}
function adminConfirmOrder_(data){var admin=adminAuthenticate_(data.token),orderId=cleanText_(data.orderId,100),status=cleanText_(data.status,50).toUpperCase(),allowed=['PENDING_PAYMENT','PAYMENT_PROCESSING','PAID','PROCESSING','DELIVERED','CANCELLED','REFUNDED','FAILED'];require_(allowed.indexOf(status)>=0,'Invalid order status.');var order=findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId);require_(order,'Order not found.');updateRowById_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId,{Status:status,UpdatedAt:isoNow_()});appendAudit_(admin.UserID,'ORDER_STATUS','Order',orderId,{status:status});return{order:findOne_(TC_CONFIG.SHEETS.ORDERS,'OrderID',orderId)};}
function ensurePaymentLinkStockSheet_(){return ensureSheet_(TC_CONFIG.SHEETS.PAYMENT_LINK_STOCK,['PaymentLinkStockID','Denomination','Link','Label','Status','OrderID','PaymentLinkID','CreatedAt','UpdatedAt']);}
