booksRoute_=function(action,input){var lock=null,locked=false;try{if(TC_ENGINE_MUTATING[action]){lock=LockService.getScriptLock();lock.tryLock(30000);locked=true;}if(action==='booksCalculateTDS')return tcEngFixedTDS_(input);if(action==='booksCreateCreditNote')return tcEngFixedNote_(input,'CREDIT');if(action==='booksCreateDebitNote')return tcEngFixedNote_(input,'DEBIT');if(action==='booksReport')return tcEngManagementReport_(input);var engine=tcEngRoute_(action,input);return engine!==null?engine:TC_BOOKS_PRE_ENGINE_ROUTE(action,input);}finally{if(locked&&lock)lock.releaseLock();}};
