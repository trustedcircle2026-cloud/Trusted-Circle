/** Trusted Circle Books - UI data service. Read/list helpers for the production workspace. */
var TC_UI_SHEETS=['Customers','Vendors','Items','Invoices','InvoiceLines','Receipts','Bills','BillLines','Payments','Expenses','BankAccounts','BankTransactions','Reconciliations','TaxRates','TaxTransactions','JournalEntries','JournalLines','AccountGroups','Accounts','Quotes','SalesOrders','PurchaseOrders','VendorCredits','CreditNotes','DebitNotes','StockLedger','FIFO_Layers','Projects','FixedAssets','Budgets','RecurringInvoices','TDSRecords','Approvals','PortalUsers','Documents','Notifications','AuditLogs','OrganisationMembers','JoinRequests','Employees','Roles','Permissions','EInvoiceWorkflows','EWayWorkflows','FYLocks','PermissionAssignments'];
function tcUiOrg_(token){var u=booksAuth_(token);booksRequire_(u.OrganisationID,'Organisation setup is required.');return u;}
function tcUiList_(input){var u=tcUiOrg_(input.token),sheet=String(input.sheet||'');booksRequire_(TC_UI_SHEETS.indexOf(sheet)>=0,'Invalid Books module.');var rows=booksRows_(sheet).filter(function(r){return String(r.OrganisationID)===String(u.OrganisationID);});var q=String(input.q||'').toLowerCase();if(q)rows=rows.filter(function(r){return JSON.stringify(r).toLowerCase().indexOf(q)>=0;});return{sheet:sheet,rows:rows};}
function tcUiSave_(input){var u=tcUiOrg_(input.token),sheet=String(input.sheet||''),record=input.record||{};booksRequire_(TC_UI_SHEETS.indexOf(sheet)>=0,'Invalid Books module.');booksRequire_(u.Role==='OWNER'||u.Role==='ADMIN'||u.Role==='ACCOUNTANT','You do not have permission to edit this module.');var sh=booksSpreadsheet_().getSheetByName(sheet);booksRequire_(sh,'Sheet not initialized: '+sheet);var h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0],idKey=h[0],id=String(record[idKey]||booksId_('ROW'));record[idKey]=id;record.OrganisationID=u.OrganisationID;if(h.indexOf('CreatedAt')>=0)record.CreatedAt=record.CreatedAt||booksIsoNow_();if(h.indexOf('UpdatedAt')>=0)record.UpdatedAt=booksIsoNow_();var old=booksFind_(sheet,idKey,id);if(old)booksUpdate_(sheet,idKey,id,record);else booksAppend_(sheet,record);return{record:booksFind_(sheet,idKey,id)||record};}
function tcUiRoute_(action,input){switch(action){case'booksUiList':return tcUiList_(input);case'booksUiSave':return tcUiSave_(input);default:return null;}}
function runBooksUiSetup(){tcEngEnsure_();tcFullEnsure_();return 'Trusted Circle Books UI service ready';}
