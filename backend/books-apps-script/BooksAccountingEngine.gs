function tcEngRoute_(action,input){tcEngEnsure_();switch(action){case'booksCreateInvoice':return tcEngInvoice_(input);case'booksCreateBill':return tcEngBill_(input);case'booksCreateCreditNote':return tcEngNote_(input,'CREDIT');case'booksCreateDebitNote':return tcEngNote_(input,'DEBIT');case'booksCreatePaymentAllocation':return tcEngAllocatePayment_(input);case'booksReconcileBank':return tcEngBankRecon_(input);case'booksStockBalance':var c=tcEngOrg_(input);return tcEngStockBalance_(c.org,input.itemId,input.warehouseId||'MAIN');case'booksFIFOValuation':var c2=tcEngOrg_(input);return{rows:tcEngRows_('FIFO_Layers',c2.org).filter(function(r){return Number(r.RemainingQty)>0;}).map(function(r){return{itemId:r.ItemID,warehouseId:r.WarehouseID,quantity:Number(r.RemainingQty),unitCost:Number(r.UnitCost),value:tcEngMoney_(Number(r.RemainingQty)*Number(r.UnitCost))};})};case'booksGSTReport':return tcEngGST_(input);case'booksGSTRData':return tcEngGstr_(input);case'booksCreateEInvoiceWorkflow':return tcEngEWorkflow_(input,'EINVOICE');case'booksCreateEWayWorkflow':return tcEngEWorkflow_(input,'EWAY');case'booksCalculateTDS':return tcEngTDS_(input);case'booksCreateRecurringInvoice':return tcEngRecurring_(input);case'booksProcessRecurringInvoices':return tcEngProcessRecurring_(input);case'booksRequestApproval':return tcEngApprovalRequest_(input);case'booksReviewApproval':return tcEngApprovalReview_(input);case'booksInvitePortalUser':return tcEngPortal_(input);case'booksSaveDocument':return tcEngDocument_(input);case'booksLockFinancialYear':return tcEngLock_(input);case'booksUnlockFinancialYear':return tcEngUnlock_(input);case'booksSwitchOrganisation':return tcEngSwitchOrg_(input);case'booksAssignPermission':return tcEngPermission_(input);case'booksReport':return tcEngReport_(input);case'booksDayBook':return tcEngDayBook_(input);case'booksGeneralLedger':return tcEngGL_(input);case'booksAccountLedger':return tcEngLedger_(input);case'booksCashFlow':return tcEngCashFlow_(input);case'boo